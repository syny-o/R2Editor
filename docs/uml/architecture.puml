@startuml
title R2Editor — component architecture

left to right direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false

package "Application shell" {
  component "main.py\nMainWindow" as Main
  component "MainWindowBuilder" as Builder
  component "WindowController" as Window
  component "ApplicationLifecycle" as Lifecycle
  component "AppSettings" as Settings
}

package "Feature areas" {
  component dashboard
  component file_browser
  component text_editor
  component data_manager
  component doors
}

package "Shared infrastructure" {
  component components
  component config
  component dialogs
  component ui
}

Main --> Builder : constructs UI
Main --> Window : navigation/window state
Main --> Lifecycle : shutdown
Main --> Settings
Main --> text_editor
Main --> data_manager

Builder --> dashboard
Builder --> file_browser
Builder --> text_editor
Builder --> data_manager

dashboard --> components
dashboard --> config
dashboard --> dialogs
dashboard --> ui

file_browser --> components
file_browser --> config
file_browser --> dialogs
file_browser --> ui

text_editor --> components
text_editor --> config
text_editor --> dialogs
text_editor --> data_manager : requirement references

data_manager --> components
data_manager --> config
data_manager --> dialogs
data_manager --> ui
data_manager --> doors
data_manager --> text_editor : open file / coverage changes

doors --> dialogs

note bottom of data_manager
  Largest feature area.
  Owns the project data tree, requirements,
  coverage, DOORS, A2L and reports.
end note

note bottom of text_editor
  Bidirectional dependency with data_manager
  is an architectural coupling point.
end note
@enduml
